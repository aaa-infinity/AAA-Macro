<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hub_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_pill"
    android:elevation="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Drag Handle / Logo -->
    <TextView
        android:id="@+id/tv_drag_handle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="#10B981"
        android:gravity="center"
        android:text="AAA"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Play / Pause Button -->
    <Button
        android:id="@+id/btn_play_pause"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#F59E0B"
        android:text="START"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Army Selector Label -->
    <TextView
        android:id="@+id/tv_army_strategy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:text="Dragon Wave"
        android:textColor="#1E293B"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Close Button -->
    <TextView
        android:id="@+id/btn_close_hub"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="✕"
        android:textColor="#EF4444"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
