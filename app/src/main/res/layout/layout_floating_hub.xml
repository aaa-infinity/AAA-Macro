<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hub_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- 1. Collapsed Dock Icon (Always visible & draggable) -->
    <FrameLayout
        android:id="@+id/dock_pill"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_dock_bubble"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tv_dock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AAA"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 2. Expanded Action Toolbar (Collapses/Expands horizontally on tap) -->
    <LinearLayout
        android:id="@+id/expanded_menu"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_expanded_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <!-- Play / Pause Action Button -->
        <ImageButton
            android:id="@+id/btn_action_play"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_action_circle"
            android:contentDescription="Play/Pause"
            android:src="@android:drawable/ic_media_play"
            android:tint="#10B981" />

        <!-- Status HUD Text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDLE"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_strategy_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dragon Wave"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Close / Exit Button -->
        <ImageButton
            android:id="@+id/btn_action_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_action_circle"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#EF4444" />
    </LinearLayout>

</LinearLayout>
