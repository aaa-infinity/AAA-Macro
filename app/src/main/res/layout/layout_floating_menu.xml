<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <!-- Collapsed Pill View (When Minimized) -->
    <LinearLayout
        android:id="@+id/pill_collapsed_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_floating_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_pill_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_pill_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="IDLE"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_pill_expand"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Expanded Full Control Card -->
    <LinearLayout
        android:id="@+id/pill_expanded_view"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_pill"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header & Drag Handle -->
        <LinearLayout
            android:id="@+id/layout_drag_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ AAA MACRO"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Minimize Button -->
            <ImageView
                android:id="@+id/btn_minimize"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/text_secondary" />

            <!-- Close Button -->
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/accent_red" />
        </LinearLayout>

        <!-- Real-Time Status Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS:"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="IDLE"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Live OCR Loot Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_live_gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gold: --"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_live_elixir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Elixir: --"
                android:textColor="@color/accent_elixir"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Loot Input Thresholds -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_target_gold"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_badge"
                android:hint="Min Gold"
                android:inputType="number"
                android:paddingHorizontal="8dp"
                android:textColor="@color/accent_gold"
                android:textColorHint="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_target_elixir"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_badge"
                android:hint="Min Elixir"
                android:inputType="number"
                android:paddingHorizontal="8dp"
                android:textColor="@color/accent_elixir"
                android:textColorHint="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Start / Pause Action Button -->
        <Button
            android:id="@+id/btn_toggle_start_pause"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_start"
            android:text="▶ START MACRO"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
